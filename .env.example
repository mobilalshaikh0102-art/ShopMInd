# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=shopmind
POSTGRES_PASSWORD=shopmind_secret
POSTGRES_DB=shopmind_db
DATABASE_URL=postgresql://shopmind:shopmind_secret@postgres:5432/shopmind_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
